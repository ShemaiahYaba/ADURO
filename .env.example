# Vercel AI Gateway (choose one auth method)
# Option A: vercel link && vercel env pull .env.local  (sets VERCEL_OIDC_TOKEN)
# Option B: API key from https://vercel.com/dashboard → AI Gateway
AI_GATEWAY_API_KEY=

# Optional model overrides
ADURO_ROUTER_MODEL=openai/gpt-4o-mini
ADURO_EMBED_MODEL=openai/text-embedding-3-small
