# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional model overrides
ADURO_ROUTER_MODEL=gpt-4o-mini
ADURO_EMBED_MODEL=text-embedding-3-small
# Scope gate (man-in-the-middle off-topic judge). Defaults to router model.
ADURO_SCOPE_MODEL=gpt-4o-mini
# enabled (default when API key present) | disabled (regex heuristic only)
ADURO_SCOPE_GATE=enabled

# Realization mode: "generated" (default) writes replies under policy constraints;
# "template" uses curated templates verbatim (A/B / offline comparison).
ADURO_REALIZATION=generated

# Optional single-pass polish for generated replies: enabled | disabled
ADURO_REFINEMENT=disabled
